<%- include('../partials/head', { title: 'Atur kata sandi baru', description: 'Buat kata sandi baru untuk akun FieldsOps Anda.' }) %>
<%- include('../partials/site-header') %>

<main id="main" class="wrap wrap-narrow">
  <div style="padding:2.5rem 0 3rem;max-width:520px">
    <p class="eyebrow">Pemulihan akun</p>
    <h1 class="h2">Atur kata sandi baru.</h1>

    <% if (error) { %>
      <div class="flash flash-error" role="alert"><div><span class="flash-label">Tidak bisa</span><%= error %></div></div>
      <a class="btn btn-primary" href="/lupa-sandi">Minta tautan baru</a>
    <% } else { %>
      <form method="post" action="/reset-sandi/<%= token %>" class="card card-pad">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="field">
          <label for="password">Kata sandi baru</label>
          <input class="input" type="password" id="password" name="password" minlength="8" autocomplete="new-password" required autofocus />
          <p class="help">Minimal 8 karakter, mengandung huruf dan angka.</p>
        </div>
        <div class="field">
          <label for="confirm_password">Ulangi kata sandi baru</label>
          <input class="input" type="password" id="confirm_password" name="confirm_password" autocomplete="new-password" required />
        </div>
        <button class="btn btn-primary btn-block" type="submit">Simpan kata sandi</button>
      </form>
    <% } %>
  </div>
</main>

<%- include('../partials/site-footer') %>
