<%- include('../partials/panel-start', { panelTitle: 'Ketersediaan', panelSub: 'Jadwal ini menjadi pertimbangan admin saat menugaskan. Anda tetap bisa menolak penawaran.' }) %>

<%
  const activeDays = {};
  slots.forEach((slot) => { activeDays[slot.day_of_week] = slot; });
%>

<form method="post" action="/teknisi/ketersediaan" class="surface">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
  <div class="surface-head">
    <h2>Jam kerja mingguan</h2>
    <span class="chip"><%= slots.length %> hari aktif</span>
  </div>
  <div class="surface-body">
    <% [1, 2, 3, 4, 5, 6, 0].forEach((day) => { %>
      <% const slot = activeDays[day]; %>
      <div style="display:flex;flex-wrap:wrap;gap:.8rem;align-items:center;padding:.7rem 0;border-bottom:1px solid var(--line)">
        <label class="check" style="min-width:150px;padding:0">
          <input type="checkbox" name="day" value="<%= day %>" <%= slot ? 'checked' : '' %> />
          <span><strong><%= days[day] %></strong></span>
        </label>
        <div class="field" style="margin:0">
          <label class="tiny muted" for="start_<%= day %>">Mulai</label>
          <input class="input" style="max-width:120px" type="time" id="start_<%= day %>" name="start_<%= day %>" value="<%= slot ? slot.start_time.slice(0,5) : '08:00' %>" />
        </div>
        <div class="field" style="margin:0">
          <label class="tiny muted" for="end_<%= day %>">Selesai</label>
          <input class="input" style="max-width:120px" type="time" id="end_<%= day %>" name="end_<%= day %>" value="<%= slot ? slot.end_time.slice(0,5) : '17:00' %>" />
        </div>
      </div>
    <% }); %>

    <button class="btn btn-primary mt-2" type="submit">Simpan ketersediaan</button>
    <p class="tiny muted mt-1 mb-0">Menghapus semua centang membuat profil ditandai tidak tersedia.</p>
  </div>
</form>

<%- include('../partials/panel-end') %>
