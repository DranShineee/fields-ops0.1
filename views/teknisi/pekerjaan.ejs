<%- include('../partials/panel-start', { panelTitle: 'Pekerjaan aktif', panelSub: 'Perbarui status dari lokasi. Setiap perubahan terlihat oleh customer dan admin.' }) %>

<section class="surface mb-2">
  <div class="surface-head">
    <h2>Sedang dikerjakan</h2>
    <span class="chip"><%= jobs.length %> pekerjaan</span>
  </div>
  <div class="surface-body">
    <% if (jobs.length === 0) { %>
      <div class="empty-state" style="border:0;background:transparent;padding:1.5rem 0">
        <span class="glyph">○</span>
        <h3>Tidak ada pekerjaan aktif</h3>
        <p>Terima penawaran dari halaman penugasan untuk mulai bekerja.</p>
        <a class="btn btn-outline btn-sm mt-2" href="/teknisi/penugasan">Lihat penugasan</a>
      </div>
    <% } else { %>
      <% jobs.forEach((job) => { %>
        <a href="/teknisi/pekerjaan/<%= job.id %>" style="display:block;text-decoration:none;border:1px solid var(--line);border-radius:5px;padding:.95rem 1rem;margin-bottom:.6rem;background:var(--paper)">
          <div class="flex-between">
            <strong><%= job.service_name %></strong>
            <div class="flex-wrap">
              <%- f.statusBadge(f.SERVICE_ORDER_STATUS, job.status) %>
              <% if (job.work_status) { %><%- f.statusBadge(f.WORK_ORDER_STATUS, job.work_status) %><% } %>
            </div>
          </div>
          <div class="tiny muted" style="margin-top:.35rem">
            <%= job.code %> · <%= job.city %> · <%= f.formatDateLong(job.scheduled_date) %> · <%= f.formatTime(job.scheduled_time) %>
          </div>
        </a>
      <% }); %>
    <% } %>
  </div>
</section>

<% if (submitted.length) { %>
  <section class="surface">
    <div class="surface-head"><h2>Menunggu tinjauan admin</h2></div>
    <div class="surface-body">
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Layanan</th><th>Booking</th><th>Status work order</th><th></th></tr></thead>
          <tbody>
            <% submitted.forEach((job) => { %>
              <tr>
                <td><%= job.service_name %></td>
                <td class="mono"><%= job.code %></td>
                <td><%- f.statusBadge(f.WORK_ORDER_STATUS, job.work_status) %></td>
                <td><a class="text-link" href="/teknisi/pekerjaan/<%= job.id %>">Buka</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </section>
<% } %>

<%- include('../partials/panel-end') %>
