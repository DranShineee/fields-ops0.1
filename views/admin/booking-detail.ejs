<%- include('../partials/panel-start', { panelTitle: 'Booking ' + booking.code, panelSub: booking.customer_name + ' · ' + booking.city + ' · ' + f.formatDateLong(booking.scheduled_date) }) %>

<div class="flex-between mb-2">
  <div class="flex-wrap">
    <%- f.statusBadge(f.BOOKING_STATUS, booking.status) %>
    <%- f.statusBadge(f.PAYMENT_STATUS, booking.payment_status) %>
    <span class="chip"><%= f.formatDateLong(booking.scheduled_date) %> · <%= f.formatTime(booking.scheduled_time) %> WIB</span>
    <% if (booking.payment_method === 'cod') { %><span class="chip">COD</span><% } %>
  </div>
  <div class="btn-row">
    <a class="text-link" href="/admin/booking">← Semua booking</a>
    <% if (booking.status === 'submitted') { %>
      <form method="post" action="/admin/booking/<%= booking.code %>/proses">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button class="btn btn-primary btn-sm" type="submit">Proses booking</button>
      </form>
    <% } %>
  </div>
</div>

<div class="split">
  <div>
    <section class="surface mb-2">
      <div class="surface-head"><h2>Service order</h2><span class="chip"><%= orders.length %></span></div>
      <div class="surface-body">
        <% orders.forEach((order) => { %>
          <% const catId = categoryByOrder[order.id]; const eligible = candidates.filter((c) => c.categories.includes(catId)); %>
          <article class="card card-pad" style="margin-bottom:.9rem">
            <div class="flex-between">
              <div>
                <strong><%= order.service_name %></strong>
                <span class="table-note"><%= order.category_name %> · <%= formatRupiah(order.price) %> · <%= order.qty %> unit</span>
              </div>
              <%- f.statusBadge(f.SERVICE_ORDER_STATUS, order.status) %>
            </div>

            <dl class="kv" style="margin-top:.7rem">
              <div><dt>Teknisi</dt><dd><%= order.technician_name || 'Belum ditugaskan' %></dd></div>
              <div><dt>Work order</dt><dd><%= order.work_status ? f.WORK_ORDER_STATUS[order.work_status].label : '—' %></dd></div>
            </dl>

            <% if (['awaiting_assignment','needs_reschedule','assigned','submitted'].includes(order.status)) { %>
              <form method="post" action="/admin/service-order/<%= order.id %>/tugaskan" style="margin-top:.8rem;border-top:1px solid var(--line);padding-top:.8rem">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <div class="field-row">
                  <div class="field" style="margin-bottom:.4rem">
                    <label for="tech-<%= order.id %>">Teknisi berkompetensi</label>
                    <select class="select" id="tech-<%= order.id %>" name="technician_id" required>
                      <option value="">Pilih teknisi</option>
                      <% eligible.forEach((candidate) => { %>
                        <option value="<%= candidate.id %>"><%= candidate.name %> · <%= candidate.active_jobs %> aktif · ★ <%= candidate.rating %></option>
                      <% }); %>
                    </select>
                    <% if (eligible.length === 0) { %><p class="error-text">Belum ada teknisi dengan kompetensi <%= order.category_name %> yang disetujui.</p><% } %>
                  </div>
                  <div class="field" style="margin-bottom:.4rem">
                    <label for="instructions-<%= order.id %>">Instruksi untuk teknisi</label>
                    <input class="input" type="text" id="instructions-<%= order.id %>" name="instructions" maxlength="600" placeholder="mis. bawa freon R32, hubungi customer 30 menit sebelum datang" />
                  </div>
                </div>
                <% if (order.status === 'assigned') { %>
                  <div class="field">
                    <label for="reason-<%= order.id %>">Alasan penugasan ulang</label>
                    <input class="input" type="text" id="reason-<%= order.id %>" name="reason" minlength="5" maxlength="300" placeholder="Wajib saat mengganti teknisi" />
                  </div>
                <% } %>
                <button class="btn btn-outline btn-sm" type="submit" <%= eligible.length === 0 ? 'disabled' : '' %>>Kirim penawaran</button>
              </form>
            <% } %>
          </article>
        <% }); %>
      </div>
    </section>

    <section class="surface mb-2">
      <div class="surface-head"><h2>Detail customer</h2></div>
      <div class="surface-body">
        <dl class="kv">
          <div><dt>Nama</dt><dd><%= booking.customer_name %></dd></div>
          <div><dt>Email</dt><dd><%= booking.customer_email %></dd></div>
          <div><dt>Telepon</dt><dd><%= booking.customer_phone || '—' %></dd></div>
          <div><dt>Alamat</dt><dd><%= booking.address %><br /><%= booking.city %><%= booking.postal_code ? ' ' + booking.postal_code : '' %></dd></div>
          <div><dt>Catatan customer</dt><dd><%= booking.notes || '—' %></dd></div>
          <div><dt>Dibuat</dt><dd><%= f.formatDateTime(booking.created_at) %></dd></div>
        </dl>
      </div>
    </section>

    <section class="surface">
      <div class="surface-head"><h2>Riwayat status</h2></div>
      <div class="surface-body">
        <ol class="timeline">
          <% timeline.forEach((row) => { %>
            <li class="timeline-item">
              <strong><%= row.to_status.replace(/_/g, ' ') %> <span class="tiny muted">· <%= row.entity_type %></span></strong>
              <small><%= f.formatDateTime(row.created_at) %> · <%= row.actor_name || 'sistem' %></small>
              <% if (row.note) { %><br /><small><%= row.note %></small><% } %>
            </li>
          <% }); %>
        </ol>
      </div>
    </section>
  </div>

  <aside>
    <section class="surface mb-2">
      <div class="surface-head"><h2>Pembayaran</h2></div>
      <div class="surface-body">
        <dl class="kv">
          <div><dt>Total</dt><dd><strong><%= formatRupiah(booking.total) %></strong></dd></div>
          <div><dt>Metode</dt><dd><%= f.PAYMENT_METHOD_LABELS[booking.payment_method] %><%= booking.payment_channel ? ' · ' + f.PAYMENT_CHANNEL_LABELS[booking.payment_channel] : '' %></dd></div>
          <div><dt>Status</dt><dd><%- f.statusBadge(f.PAYMENT_STATUS, booking.payment_status) %></dd></div>
          <div><dt>Referensi</dt><dd class="mono"><%= transaction ? transaction.reference : '—' %></dd></div>
        </dl>
        <% if (transaction) { %>
          <% if (transaction.proof_url) { %><p class="small mt-2 mb-1"><a class="link" href="<%= transaction.proof_url %>" target="_blank" rel="noopener">Lihat bukti pembayaran</a></p><% } %>
          <div class="btn-row">
            <% if (transaction.status === 'pending_verification' || transaction.status === 'unpaid') { %>
              <form method="post" action="/admin/transaksi/<%= transaction.id %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <input type="hidden" name="action" value="verifikasi" />
                <button class="btn btn-primary btn-sm" type="submit">Tandai lunas</button>
              </form>
            <% } %>
            <% if (transaction.status === 'pending_verification') { %>
              <form method="post" action="/admin/transaksi/<%= transaction.id %>" data-confirm="Tolak bukti pembayaran ini?">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <input type="hidden" name="action" value="tolak" />
                <button class="btn btn-danger btn-sm" type="submit">Tolak bukti</button>
              </form>
            <% } %>
          </div>
        <% } %>
        <a class="text-link mt-2" href="/admin/transaksi">Halaman transaksi →</a>
      </div>
    </section>

    <section class="surface">
      <div class="surface-head"><h2>Aksi</h2></div>
      <div class="surface-body">
        <% if (booking.status !== 'cancelled') { %>
          <details>
            <summary style="cursor:pointer;font-size:.86rem;font-weight:600">Batalkan booking</summary>
            <form method="post" action="/admin/booking/<%= booking.code %>/batal" style="margin-top:.6rem" data-confirm="Batalkan booking <%= booking.code %>?">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <div class="field">
                <label for="cancel_reason">Alasan</label>
                <textarea class="textarea" id="cancel_reason" name="reason" rows="2" minlength="5" required style="min-height:60px"></textarea>
              </div>
              <button class="btn btn-danger btn-sm" type="submit">Batalkan booking</button>
            </form>
          </details>
        <% } else { %>
          <p class="small mb-1"><strong>Alasan pembatalan:</strong> <%= booking.cancel_reason || '—' %></p>
        <% } %>
        <p class="tiny muted mt-2 mb-0">Customer melihat perubahan status di halaman booking dan menerima notifikasi.</p>
      </div>
    </section>
  </aside>
</div>

<%- include('../partials/panel-end') %>
