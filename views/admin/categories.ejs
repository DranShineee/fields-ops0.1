<%- include('../partials/panel-start', { panelTitle: 'Kategori layanan', panelSub: 'Kategori menentukan kompetensi teknisi. Nonaktifkan kategori alih-alih menghapus agar riwayat tetap utuh.' }) %>

<div class="split">
  <section class="surface">
    <div class="surface-head"><h2>Daftar kategori</h2><span class="chip"><%= categories.length %></span></div>
    <div class="surface-body">
      <div class="table-wrap" style="border:0">
        <table class="table">
          <thead><tr><th>Urutan</th><th>Kategori</th><th>Layanan</th><th>Status</th><th></th></tr></thead>
          <tbody>
            <% categories.forEach((cat) => { %>
              <tr>
                <td class="mono"><%= cat.sort_order %></td>
                <td>
                  <strong><%= cat.name %></strong>
                  <span class="table-note">/layanan?kategori=<%= cat.slug %></span>
                </td>
                <td><%= cat.service_count %></td>
                <td><%- f.statusBadge({ aktif: { label: 'Aktif', tone: 'done' }, nonaktif: { label: 'Nonaktif', tone: 'cancel' } }, cat.is_active ? 'aktif' : 'nonaktif') %></td>
                <td><a class="text-link" href="/admin/kategori/<%= cat.id %>/edit">Edit</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <form method="post" action="/admin/kategori" class="surface sticky-card">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input type="hidden" name="id" value="<%= editing ? editing.id : '' %>" />
    <div class="surface-head">
      <h2><%= editing ? 'Edit kategori' : 'Kategori baru' %></h2>
      <% if (editing) { %><a class="text-link tiny" href="/admin/kategori">Batal</a><% } %>
    </div>
    <div class="surface-body">
      <div class="field">
        <label for="name">Nama kategori</label>
        <input class="input" type="text" id="name" name="name" value="<%= editing ? editing.name : '' %>" required />
      </div>
      <div class="field">
        <label for="description">Deskripsi singkat</label>
        <textarea class="textarea" id="description" name="description" rows="2" maxlength="240" style="min-height:64px"><%= editing ? editing.description || '' : '' %></textarea>
      </div>
      <div class="field-row">
        <div class="field">
          <label for="icon">Ikon</label>
          <select class="select" id="icon" name="icon">
            <% ['ac','motor','laptop','bike','wrench'].forEach((icon) => { %>
              <option value="<%= icon %>" <%= editing && editing.icon === icon ? 'selected' : '' %>><%= icon %></option>
            <% }); %>
          </select>
        </div>
        <div class="field">
          <label for="sort_order">Urutan</label>
          <input class="input" type="number" id="sort_order" name="sort_order" value="<%= editing ? editing.sort_order : 0 %>" />
        </div>
      </div>
      <label class="check">
        <input type="checkbox" name="is_active" <%= !editing || editing.is_active ? 'checked' : '' %> />
        <span>Tampilkan di katalog</span>
      </label>
      <button class="btn btn-primary btn-block mt-1" type="submit"><%= editing ? 'Simpan perubahan' : 'Buat kategori' %></button>
      <p class="tiny muted mt-1 mb-0">Slug dibuat otomatis dari nama kategori.</p>
    </div>
  </form>
</div>

<%- include('../partials/panel-end') %>
