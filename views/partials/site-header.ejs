<header class="site-header">
  <div class="header-shell">
    <a class="brand" href="/" aria-label="FieldsOps — beranda">
      <span class="brand-mark" aria-hidden="true">F.</span>
      <span class="brand-text">
        <strong>FieldsOps</strong>
        <small>Jasa lapangan</small>
      </span>
    </a>

    <button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="main-nav">
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span class="sr-only">Buka menu</span>
    </button>

    <nav class="main-nav" id="main-nav" data-nav aria-label="Navigasi utama">
      <a href="/layanan" class="nav-link <%= currentPath.startsWith('/layanan') ? 'active' : '' %>">Layanan</a>
      <a href="/kategori" class="nav-link <%= currentPath === '/kategori' ? 'active' : '' %>">Kategori</a>
      <a href="/#cara-kerja" class="nav-link">Cara kerja</a>
      <% if (currentUser && currentUser.role === 'customer') { %>
        <a href="/akun" class="nav-link <%= currentPath === '/akun' || currentPath.startsWith('/booking') ? 'active' : '' %>">Booking saya</a>
      <% } %>
    </nav>

    <div class="nav-actions">
      <% if (currentUser) { %>
        <a href="/notifikasi" class="icon-btn" aria-label="Notifikasi<%= unreadCount ? ' (' + unreadCount + ' belum dibaca)' : '' %>">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 8-3 8h18s-3-1-3-8"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
          <% if (unreadCount) { %><span class="dot" aria-hidden="true"></span><% } %>
        </a>
        <a href="<%= currentUser.role === 'admin' ? '/admin' : currentUser.role === 'technician' ? '/teknisi' : '/akun' %>" class="user-chip">
          <span class="avatar" aria-hidden="true"><%= f.initials(currentUser.name) %></span>
          <span class="user-meta">
            <strong><%= currentUser.name.split(' ')[0] %></strong>
            <small><%= f.roleLabel(currentUser.role) %></small>
          </span>
        </a>
        <form method="post" action="/logout" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="btn btn-ghost btn-sm">Keluar</button>
        </form>
      <% } else { %>
        <a href="/login" class="nav-link nav-login">Masuk</a>
        <a href="/register" class="btn btn-primary btn-sm">Buat akun</a>
      <% } %>
    </div>
  </div>
</header>
