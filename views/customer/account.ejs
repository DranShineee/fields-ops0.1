<%- include('../partials/head', { title: 'Akun saya', description: 'Ringkasan booking, alamat, dan notifikasi akun FieldsOps Anda.' }) %>
<%- include('../partials/site-header') %>

<main id="main" class="wrap">
  <div class="page-head">
    <div>
      <p class="eyebrow">Akun customer</p>
      <h1>Halo, <%= currentUser.name.split(' ')[0] %>.</h1>
      <p><%= profile && profile.address ? profile.address + ', ' + (profile.city || '') : 'Lengkapi alamat agar booking berikutnya lebih cepat.' %></p>
    </div>
    <div class="btn-row">
      <a class="btn btn-outline btn-sm" href="/profil">Profil &amp; alamat</a>
      <a class="btn btn-primary btn-sm" href="/layanan">Pesan layanan</a>
    </div>
  </div>

  <%- include('../partials/flash') %>

  <div class="stat-cards">
    <div class="stat-card"><span class="stat-card-value"><%= stats.total || 0 %></span><span class="stat-card-label">Total booking</span></div>
    <div class="stat-card"><span class="stat-card-value"><%= stats.active || 0 %></span><span class="stat-card-label">Sedang berjalan</span></div>
    <div class="stat-card"><span class="stat-card-value"><%= stats.completed || 0 %></span><span class="stat-card-label">Selesai</span></div>
    <div class="stat-card"><span class="stat-card-value" style="font-size:1.15rem"><%= f.formatRupiah(stats.spent || 0) %></span><span class="stat-card-label">Total dibayar</span></div>
  </div>

  <div class="split" style="padding-bottom:2.5rem">
    <div>
      <div class="card mb-2">
        <div class="card-head">
          <h2>Booking berjalan</h2>
          <a class="text-link" href="/akun#riwayat">Semua</a>
        </div>
        <div class="card-body">
          <% if (upcoming.length === 0) { %>
            <div class="empty-state" style="border:0;background:transparent;padding:1.5rem 0">
              <span class="glyph">◷</span>
              <h3>Tidak ada pekerjaan aktif</h3>
              <p>Butuh sesuatu diperbaiki? Pilih layanan dan tentukan jam kunjungan.</p>
              <a class="btn btn-outline btn-sm mt-2" href="/layanan">Cari layanan</a>
            </div>
          <% } else { %>
            <% upcoming.forEach((booking) => { %>
              <a href="/booking/<%= booking.code %>" style="display:block;text-decoration:none;border:1px solid var(--line);border-radius:5px;padding:.9rem 1rem;margin-bottom:.6rem;background:var(--paper)">
                <div class="flex-between">
                  <strong class="mono"><%= booking.code %></strong>
                  <%- f.statusBadge(f.BOOKING_STATUS, booking.status) %>
                </div>
                <div class="small muted" style="margin-top:.3rem">
                  <%= f.formatDateLong(booking.scheduled_date) %> · <%= f.formatTime(booking.scheduled_time) %> · <%= booking.item_count %> layanan · <%= booking.city %>
                </div>
              </a>
            <% }); %>
          <% } %>
        </div>
      </div>

      <div class="card" id="riwayat">
        <div class="card-head">
          <h2>Booking terakhir</h2>
          <span class="chip"><%= stats.total || 0 %> total</span>
        </div>
        <div class="card-body">
          <% if (recent.length === 0) { %>
            <p class="small muted mb-0">Belum ada booking. Riwayat akan muncul di sini setelah Anda memesan layanan pertama.</p>
          <% } else { %>
            <% recent.forEach((booking) => { %>
              <a href="/booking/<%= booking.code %>" style="display:flex;justify-content:space-between;gap:1rem;align-items:center;padding:.7rem 0;border-bottom:1px solid var(--line);text-decoration:none">
                <span>
                  <strong class="small mono"><%= booking.code %></strong>
                  <span class="table-note"><%= f.formatDate(booking.scheduled_date) %> · <%= booking.item_count %> layanan · <%= f.formatRupiah(booking.total) %></span>
                </span>
                <%- f.statusBadge(f.BOOKING_STATUS, booking.status) %>
              </a>
            <% }); %>
          <% } %>
        </div>
      </div>
    </div>

    <aside>
      <div class="card mb-2">
        <div class="card-head"><h2>Notifikasi</h2><a class="text-link tiny" href="/notifikasi">Semua</a></div>
        <div class="card-body">
          <% if (notifications.length === 0) { %>
            <p class="small muted mb-0">Tidak ada notifikasi baru.</p>
          <% } else { %>
            <% notifications.forEach((item) => { %>
              <div style="padding:.55rem 0;border-bottom:1px solid var(--line)">
                <strong class="small"><%= item.title %></strong>
                <p class="tiny muted mb-0"><%= item.body %></p>
              </div>
            <% }); %>
          <% } %>
        </div>
      </div>

      <div class="card card-pad mb-2">
        <h2 class="h3" style="font-size:.95rem">Akses cepat</h2>
        <div class="btn-row" style="margin-top:.6rem">
          <a class="btn btn-outline btn-sm" href="/keluhan">Bantuan &amp; keluhan</a>
          <a class="btn btn-ghost btn-sm" href="/profil#sandi">Ganti kata sandi</a>
        </div>
      </div>

      <div class="card card-pad">
        <h2 class="h3" style="font-size:.95rem">Alamat tersimpan</h2>
        <% if (profile && profile.address) { %>
          <p class="small mb-1"><%= profile.address %></p>
          <p class="tiny muted mb-0"><%= profile.city %><%= profile.postal_code ? ' · ' + profile.postal_code : '' %></p>
        <% } else { %>
          <p class="small muted">Belum ada alamat tersimpan.</p>
        <% } %>
        <a class="text-link mt-2" href="/profil">Ubah alamat →</a>
      </div>
    </aside>
  </div>
</main>

<%- include('../partials/site-footer') %>
