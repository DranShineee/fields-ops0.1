# ============================================================
# FieldsOps — contoh konfigurasi environment
# Salin menjadi `.env` (lokal) atau isi di Vercel → Settings → Environment Variables.
# ============================================================

# ------------------------------------------------------------
# Aplikasi
# ------------------------------------------------------------
# development | production (production mewajibkan SESSION_SECRET kuat + cookie secure)
NODE_ENV=development

# Port server lokal. Di Vercel tidak dipakai (fungsi serverless).
PORT=3000

# Kunci penandatangan cookie sesi. WAJIB diganti di production.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# ------------------------------------------------------------
# Database MySQL (mysql2/promise connection pool)
# ------------------------------------------------------------
# Host MySQL harus bisa diakses dari Vercel (PlanetScale, Aiven, Railway, TiDB,
# atau managed MySQL lain). Sertakan TLS sesuai penyedia.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fieldsops

# Koneksi maksimum per instance serverless. Vercel membuat banyak instance
# singkat, jadi gunakan 2–5 agar tidak menghabiskan slot koneksi database.
DB_POOL=2

# ------------------------------------------------------------
# Penyimpanan berkas
# ------------------------------------------------------------
# Folder berkas privat (dokumen KTP, bukti transfer, bukti pekerjaan).
# Di Vercel hanya /tmp yang writable dan isinya hilang saat instance berhenti;
# untuk produksi gunakan object storage (S3/R2) dan sesuaikan src/routes/files.js.
STORAGE_DIR=storage/private

# Folder unggahan publik.
UPLOAD_DIR=public/uploads

# Batas ukuran unggahan (byte). Default 3 MB.
UPLOAD_MAX_BYTES=3145728
